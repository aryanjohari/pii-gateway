%% PII Gateway — portfolio / How it works diagram (aligned with C2)
%% Canonical Mermaid source. Keep in sync with docs/c4/2-containers.* and architecture.graph.json.
%% View: https://mermaid.live  |  local: open docs/view-architecture.html

flowchart TB
  subgraph inputs["Inputs"]
    APP[Apps / scripts]
    AUTO[Automation]
    PG[(PostgreSQL)]
    INBOX[CSV / JSON inbox]
  end

  subgraph core["PII Gateway — single FastAPI container"]
    SAN[Sanitize API<br/>POST /v1/sanitize]
    JOBS[Batch jobs<br/>POST /internal/jobs/*]
    HZ[GET /healthz]
    POL[Policy file]
    PIPE[Sanitize pipeline]
    PR[Presidio engines]
  end

  subgraph outputs["Outputs"]
    RESP[Cleaned response]
    ART[(Artifacts<br/>local or S3)]
  end

  APP -->|JSON + X-API-Key| SAN
  AUTO -.->|internal key| JOBS
  PG -.->|named SQL| JOBS
  INBOX -.->|local or S3| JOBS
  SAN --> PIPE
  JOBS -.-> PIPE
  POL --> PIPE
  PIPE --> PR
  PIPE --> RESP
  PIPE -.->|optional raw / cleaned| ART
  HZ -.-> core
