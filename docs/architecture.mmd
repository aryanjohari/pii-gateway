%% PII Gateway — C2 flowchart alias (NON-CANONICAL)
%% Source of truth: docs/c4/2-containers.mmd (+ docs/c4/portfolio-map.json)
%% Keep this file aligned with C2 containers only — no pipeline/Presidio boxes.
%% View: https://mermaid.live  |  local: open docs/view-architecture.html

flowchart TB
  integrator[App integrator]
  automator[Automation]
  operator[Operator]

  subgraph deployment["PII Gateway deployment"]
    gw["pii-gateway<br/>FastAPI / Uvicorn"]
    policy[(policy-file)]
    local[(local-volume)]
  end

  postgres[(PostgreSQL)]
  s3[(S3-compatible)]

  integrator -->|"POST /v1/sanitize + X-API-Key"| gw
  automator -->|"POST /internal/jobs/* + X-Internal-Job-Key"| gw
  operator --> policy
  gw --> policy
  gw -.->|optional named SQL| postgres
  gw -.->|optional inbox / artifacts| s3
  gw -->|artifacts + state| local
