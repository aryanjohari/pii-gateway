# Server-only — never expose these to the browser.
# Point at local Compose while developing:
#   docker compose up --build
#   PII_GATEWAY_API_URL=http://127.0.0.1:8000
#   PII_GATEWAY_API_KEY=<same as SANITIZE_HTTP_API_KEY in gateway .env>
#
# Later: replace URL with your Cloudflare Tunnel hostname to the Pi.
PII_GATEWAY_API_URL=
PII_GATEWAY_API_KEY=
